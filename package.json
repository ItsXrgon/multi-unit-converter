{
	"name": "multi-unit-converter",
	"version": "2.0.0",
	"description": "Parse measurements in text and convert them in place to SI, metric, imperial, or custom units",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "commonjs",
	"scripts": {
		"build": "tsc",
		"test": "jest",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"prepublishOnly": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ItsXrgon/multi-unit-converter.git"
	},
	"keywords": [
		"unit-conversion",
		"convert-units",
		"measurement-parser",
		"extract-measurements",
		"convert-text",
		"parse-units",
		"si-units",
		"metric",
		"imperial",
		"quantities",
		"typescript"
	],
	"author": "ItsXrgon",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/itsXrgon/multi-unit-converter/issues"
	},
	"homepage": "https://github.com/itsXrgon/multi-unit-converter#readme",
	"files": [
		"dist"
	],
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/js-quantities": "^1.6.6",
		"@types/node": "^22.15.3",
		"jest": "29.5.0",
		"prettier": "^3.5.3",
		"ts-jest": "^29.4.12",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"js-quantities": "^1.8.0"
	}
}
